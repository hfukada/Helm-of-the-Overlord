{
  "name": "hoto",
  "version": "0.1.0",
  "description": "Multi-repo, multi-agent one-shot task manager",
  "type": "module",
  "bin": {
    "hoto": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "daemon": "bun run src/index.ts daemon start",
    "test": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from test",
    "test:local": "bun test",
    "test:e2e": "bun test tests/e2e-hello-world.test.ts",
    "lint": "bunx biome lint ./src/",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@chroma-core/ollama": "0.1.8",
    "chromadb": "3.4.0",
    "discord.js": "14.16.3",
    "hono": "^4.7.0",
    "matrix-js-sdk": "^34.0.0",
    "ollama": "^0.6.3",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
