FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git bash ca-certificates unzip xz-utils python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && git config --global user.email "hoto@localhost" \
    && git config --global user.name "hoto"

# Install Docker CLI + compose plugin (static binaries)
RUN curl -fsSL https://download.docker.com/linux/static/stable/$(uname -m)/docker-27.5.1.tgz \
    | tar xz --strip-components=1 -C /usr/local/bin docker/docker \
    && mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -fsSL "https://github.com/docker/compose/releases/download/v2.35.1/docker-compose-linux-$(uname -m)" \
       -o /usr/local/lib/docker/cli-plugins/docker-compose \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

RUN curl -fsSL https://bun.sh/install | bash

# Install Node.js (includes npm)
RUN ARCH=$(uname -m) \
    && case "$ARCH" in \
        x86_64) NODE_ARCH="x64" ;; \
        aarch64) NODE_ARCH="arm64" ;; \
        *) echo "Unsupported arch: $ARCH" && exit 1 ;; \
    esac \
    && curl -fsSL "https://nodejs.org/dist/v22.13.1/node-v22.13.1-linux-${NODE_ARCH}.tar.xz" \
       | tar -xJ --strip-components=1 -C /usr/local

# Install Go
RUN ARCH=$(uname -m) \
    && case "$ARCH" in \
        x86_64) GO_ARCH="amd64" ;; \
        aarch64) GO_ARCH="arm64" ;; \
        *) echo "Unsupported arch: $ARCH" && exit 1 ;; \
    esac \
    && curl -fsSL "https://go.dev/dl/go1.24.2.linux-${GO_ARCH}.tar.gz" \
       | tar -xz -C /usr/local

# Install Claude Code CLI
RUN curl -fsSL https://claude.ai/install.sh | bash
ENV PATH="/usr/local/go/bin:/root/.bun/bin:/root/.local/bin:$PATH"

WORKDIR /workspace

CMD ["sleep", "infinity"]
