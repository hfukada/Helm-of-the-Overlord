FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git bash ca-certificates unzip \
    && rm -rf /var/lib/apt/lists/* \
    && git config --global user.email "hoto@localhost" \
    && git config --global user.name "hoto"

# Install Docker CLI + compose plugin (static binaries)
RUN curl -fsSL https://download.docker.com/linux/static/stable/$(uname -m)/docker-27.5.1.tgz \
    | tar xz --strip-components=1 -C /usr/local/bin docker/docker \
    && mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -fsSL "https://github.com/docker/compose/releases/download/v2.35.1/docker-compose-linux-$(uname -m)" \
       -o /usr/local/lib/docker/cli-plugins/docker-compose \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:$PATH"

RUN bun install -g @anthropic-ai/claude-code \
    && ln -s /root/.bun/bin/bun /usr/local/bin/node

COPY global_claude.md /root/.claude/CLAUDE.md

WORKDIR /workspace

CMD ["sleep", "infinity"]
